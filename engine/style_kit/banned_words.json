    "就在这一刻",
    "这一刻，",
    "此刻，",
    "悄然",
    "油然而生",
    "莫名",
    "没来由",
    "一股",
    "目光如炬",
    "若有所思",
    "陷入沉思",
    "微微一愣",
    "心头一紧",
    "心里一紧",
    "空气凝固",
    "空气安静",
    "指尖泛白",
    "指节泛白",
    "心跳如鼓",
    "心跳漏了半拍",
    "呼吸一窒",
    "忘了呼吸",
    "后颈汗毛竖起",
    "头皮发麻",
    "脊背发凉",
    "倒吸一口凉气",
    "深吸一口气",
    "眼中闪过",
    "嘴角勾起",
    "勾起一抹",
    "意味深长",
    "意味深长的背影",
    "良久",
    "半晌",
    "沉默片刻",
    "沉默了几秒",
    "顿了顿",
    "心中暗道",
    "心里暗道",
    "涌上心头",
    "涌起",
    "一丝",
    "一缕",
    "一片死寂",
    "安静得可怕",
    "脑海中闪过",
    "脑海里浮现",
    "说不上来",
    "难以形容",
    "难以名状",
    "说不出哪里不对"
  ],
  "soft_words": {
    "仿佛": 3,
    "似乎": 3,
    "好像": 3,
    "忽然": 3,
    "猛地": 3,
    "微微": 1,
    "轻轻": 1,
    "淡淡": 1,
    "感到": 1,
    "觉得": 2,
    "突然": 3,
    "显然": 2,
    "或许": 3
  },
  "patterns": [
    {
      "id": "bushi_ershi",
      "regex": "不是[^，。；！？]{1,15}[，,]\\s*(而)?是",
      "severity": "hard",
      "why": "AI最爱的对比句式，出现即拆成两句或只留后半"
    },
    {
      "id": "buduan_bu",
      "regex": "不仅[^。]{1,20}[，,]更[^。]{1,20}",
      "severity": "hard",
      "why": "AI全面覆盖强迫症，拆成两句或只说一半"
    },
    {
      "id": "jidao",
      "regex": "(突然意识到|终于明白|意识到(了)?|懂得了)",
      "severity": "hard",
      "limit": 1,
      "why": "心理揭示句，删掉，写人物做了什么"
    },
    {
      "id": "burenzhi",
      "regex": "他(们|她)?不知道的是",
      "severity": "hard",
      "why": "AI铺伏笔最偷懒的方式"
    },
    {
      "id": "shen_responsive",
      "regex": "(尽管|虽然)[^。]{2,25}[，,](但是|却|可)",
      "severity": "soft",
      "limit": 1,
      "why": "让步句式，拆成两句"
    },
    {
      "id": "pofihao",
      "regex": "——",
      "severity": "hard",
      "limit": 0,
      "why": "破折号清零，用逗号或句号"
    },
    {
      "id": "maohao_jieshi",
      "regex": "(核心是|值得注意的是|值得一提的是|换句话说|一句话总结)",
      "severity": "hard",
      "why": "作者跳出来解说，AI腔"
    },
    {
      "id": "yuqikuaishen",
      "regex": "语气[^。]{0,6}(说|道|回答)",
      "severity": "soft",
      "limit": 1,
      "why": "语气XX地说是AI对话标签"
    },
    {
      "id": "shengyin_buda",
      "regex": "声音不大[^。]{0,10}却",
      "severity": "hard",
      "why": "AI装腔台词"
    },
    {
      "id": "wanmei_shouwei",
      "regex": "(仿佛在诉说着|无声地诉|见证了)",
      "severity": "hard",
      "why": "景物拟人升华句"
    }
  ],
  "replacements": {
    "然而": "可 / 但",
    "因此": "就 / 所以",
    "于是": "然后（或直接写动作）",
    "忽然": "冷不丁 / 突然 / 一下",
    "微微": "低了低头（具体动作）",
    "轻轻": "踢了踢（具体动作）",
    "分明": "摆明",
    "俨然": "活像个",
    "似乎": "八成 / 看着像",
    "仿佛/犹如": "删掉，直接写本体",
    "深吸一口气": "删，直接写后续动作",
    "空气凝固": "写具体声音：空调停了。冰箱也没响。",
    "眼中闪过一丝X": "整句删除，换身体动作或对话",
    "沉默片刻": "用动作填充：他把烟掐了。又点了一根。"
  },
  "template_props_watch": [
    "监控摄像头",
    "U盘",
    "旧相册",
    "老照片",
    "未发送的短信",
    "不知开哪扇门的钥匙",
