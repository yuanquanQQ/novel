    "匿名纸条",
    "手写纸条",
    "百度街景",
    "按钮磨损"
  ],
  "metrics": {
    "dialogue_ratio_min": 0.25,
    "dialogue_ratio_max": 0.5,
    "max_same_len_run": 3,
    "sentence_len_pair_max": 22,
    "ellipsis_per_paragraph_max": 1,
    "same_para_opener_max": 2
  }
}