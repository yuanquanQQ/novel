{
  "_meta": {
    "version": "1.0",
    "source": "engine/style_kit — 源自 novel-live-writing skill（banned-words.md）+ 引擎原有黑名单",
    "usage": "scanner.py 确定性扫描；prompts_loader 格式化注入 writer/reviewer 提示词；前端风格工坊可编辑"
  },
  "hard_words": [
    "然而",
    "因此",
